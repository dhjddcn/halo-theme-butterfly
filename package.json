{
  "name": "halo-theme-butterfly",
  "version": "2.0.7",
  "description": "一个Halo博客主题，Butterfly",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "lint": "eslint ./src --ext .js,.cjs,.mjs,.ts,.cts,.mts --ignore-path .gitignore",
    "prepare": "husky",
    "prettier": "prettier --write './**/*.{ts,json,yaml,yml,html}'",
    "watch:dev": "chokidar \"templates/**/*.html\" \"src/**/*\" --command \"npm run build\""
  },
  "files": [
    "templates/assets/",
    "docs/"
  ],
  "keywords": [
    "halo",
    "halo-theme",
    "halo-theme-butterfly"
  ],
  "lint-staged": {
    "*.{ts,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "homepage": "https://github.com/dhjddcn/halo-theme-butterfly#readme",
  "bugs": {
    "url": "https://github.com/dhjddcn/halo-theme-butterfly/issues"
  },
  "author": {
    "name": "小红",
    "url": "https://github.com/dhjddcn",
    "email": "dhjddcn@qq.com"
  },
  "maintainers": [
    {
      "name": "小红",
      "url": "https://github.com/dhjddcn",
      "email": "dhjddcn@qq.com"
    }
  ],
  "license": "GPL-3.0",
  "repository": {
    "url": "https://github.com/dhjddcn/halo-theme-butterfly",
    "type": "git"
  },
  "devDependencies": {
    "@types/node": "18.11.9",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@unocss/core": "^0.64.1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^2.8.8",
    "typescript": "^4.9.5",
    "unocss": "^0.64.1",
    "vite": "^5.4.11"
  }
}
